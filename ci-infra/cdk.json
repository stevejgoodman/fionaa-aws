{
  "app": "node dist/bin/ci-infra.js",
  "watch": {
    "include": ["**"],
    "exclude": ["README.md", "cdk*.json", "tsconfig.json", "package*.json", "node_modules", "dist", "cdk.out"]
  },
  "context": {

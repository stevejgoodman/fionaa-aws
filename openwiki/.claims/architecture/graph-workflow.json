    {
      "id": "claim_fb8db328cea341db95dc470cb9fa447e",
      "statement": "FIONAA’s graph uses checkpointed ApplicationState for workflow data and AgentContext for per-invocation dependencies such as the application store, policy-doc store, and live tools; runtime context is intentionally excluded from checkpointed state because it is invocation-scoped and not serialized into checkpoints.",
      "evidence": [
        {
          "resource": "repo://fionaa/app/src/fionaa/graph.py#L21-L32",
          "version": "repo-lines-v1:sha256:801d83d5a22ac763944bdee1f1b331461d70174971bc9e3826f56c4d6712ab17:"
        },
        {

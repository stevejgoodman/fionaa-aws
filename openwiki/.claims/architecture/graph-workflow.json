    },
    {
      "id": "claim_a078d24ee9c14561842ca92d9f4b5f71",
      "statement": "`load_application` reads `input/application.json` from the runtime store, discovers staged documents by prefix under `input/`, validates them against the configured schemas, and fails if the application is missing or a staged document is invalid; `DOCUMENT_SPECS.applies_to` lets future document types opt out without changing loader control flow.",
      "evidence": [
        {
          "resource": "repo://fionaa/app/src/fionaa/workflow/loading.py#L14-L75",

        }
      ]
    },
    {
      "id": "claim_8e89ca3e44384437a7eb9e75c395ae30",
      "statement": "The workflow executes in a fixed linear order from START through load_application, policy_check, companies_house, financial_assessment, web_search, and synthesize_decision, with only companies_house branching conditionally to reject_no_company or financial_assessment.",
      "evidence": [
        {
          "resource": "repo://fionaa/app/fionaa/graph.py#L546-L589",
          "version": "repo-lines-v1:sha256:4dc46fce0e253918f37456101d421dd2781e0474cbac12c69b068d63cd4716de:"
        }
      ]
    },
    {
      "id": "claim_d4b0084e6eea43a6ba844b71678d3000",
      "statement": "load_application reads input/application.json from the runtime store, loads additional staged documents by prefix, validates them against the expected schemas, and fails loudly if the application is missing or a staged document is malformed.",

    {
      "id": "claim_34ef33bd1a7348548d600c5cd0d5c2e1",
      "statement": "`financial_assessment` only runs on the confirmed-company branch, computes a deterministic cross-check against annual accounts before the agent runs, asks the model to copy that cross-check verbatim, and persists the structured result plus tool-call evidence to `financial_assessment/result.json`.",
      "evidence": [

    {
      "id": "claim_a0afa20cf3e5445695a35db93b232f3d",
      "statement": "FIONAA’s graph uses checkpointed ApplicationState for workflow data and AgentContext for per-invocation dependencies such as the application store, policy-doc store, and live tools; the runtime context is intentionally excluded from checkpointed state because it is not serializable and is invocation-scoped.",
      "evidence": [
        {
          "resource": "repo://fionaa/app/fionaa/graph.py#L546-L556",
          "version": "repo-lines-v1:sha256:b4b95bd801e2467fc8f5657e3e90d666f2c772b8738ed69ac84f4203bdc4b0de:"
        },
        {

    },
    {
      "id": "claim_e80ab2131ab545909b98892c35f21b11",
      "statement": "The workflow is mostly linear, but `companies_house` is the only runtime branch: the graph goes START → `load_application` → `policy_check` → `validate_policy_assessment` → `companies_house`, then routes to `financial_assessment` when the company is confirmed or to `reject_no_company` otherwise; the confirmed-company path continues through `web_search`, `synthesize_decision`, and `validate_final_decision` before END.",
      "evidence": [
        {
          "resource": "repo://fionaa/app/src/fionaa/graph.py#L32-L67",
          "version": "repo-lines-v1:sha256:b3a8d6167005317da8c923221b541bdd3ba38fe879f0601634e2632f029883e4:"
        },
        {

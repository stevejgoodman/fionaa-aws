    {
      "id": "claim_878e415804e143df9df78d2af5ac9ca5",
      "statement": "`gateway.py` resolves the Gateway OAuth client secret from Secrets Manager, mints a fresh client-credentials access token per invocation using the configured client id, scopes, and token endpoint, and attaches that bearer token to a `MultiServerMCPClient` configured for `AGENTCORE_GATEWAY_URL` over `streamable_http`.",
      "evidence": [
        {
          "resource": "repo://fionaa/app/src/fionaa/gateway.py#L20-L79",

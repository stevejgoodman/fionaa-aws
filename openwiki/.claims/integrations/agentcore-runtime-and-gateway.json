    {
      "id": "claim_aded66460b2c4f66885df2dc9f470ffb",
      "statement": "`build_checkpointer(session, memory_id)` constructs an `AgentCoreMemorySaver` from the customer-scoped boto3 session credentials and memory id, so checkpoint access uses the invocation's scoped credentials instead of the ambient runtime role; `checkpoint_config(identity)` scopes LangGraph checkpoint state by setting `thread_id` to the application id and `actor_id` to the customer id derived from verified identity.",
      "evidence": [
        {
          "resource": "repo://fionaa/app/src/fionaa/integrations/checkpointing.py#L10-L49",
          "version": "repo-lines-v1:sha256:6165f613c5bdab76baef5b54fc43f04ae303240f1964ee1bbc7e71e9cf57e540:"

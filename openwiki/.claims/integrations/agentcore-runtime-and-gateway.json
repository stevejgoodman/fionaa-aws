    {
      "id": "claim_183a44478da94724849871dd5ccc4753",
      "statement": "FIONAA enters through a single Bedrock AgentCore entrypoint, `invoke(payload, context)`, which derives trusted identity from the runtime context, builds a scoped boto3 session, creates a checkpointer, loads gateway tools, and invokes the LangGraph workflow with an empty initial state and runtime `AgentContext`.",
      "evidence": [
        {
          "resource": "repo://fionaa/app/src/fionaa/gateway.py#L20-L79",
          "version": "repo-lines-v1:sha256:ef364734b768085311f2155c881867348f7a74d3ec9104b427e4536653f446da:"
        },

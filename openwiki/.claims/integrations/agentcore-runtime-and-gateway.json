          "version": "repo-lines-v1:sha256:2ef61303022a1f676c2b636798455b45a008fda546fcfa63da2dd177e3691741:"
        }
      ]
    },
    {
      "id": "claim_98c7616c439e46049fa7917723679c2e",
      "statement": "`checkpoint_config(identity)` derives LangGraph checkpoint scope from verified identity by setting `thread_id` to the application id and `actor_id` to the customer id, and `build_checkpointer(session)` constructs `AgentCoreMemorySaver` from the scoped session credentials so checkpoint access is tied to the customer-scoped session rather than ambient runtime credentials.",

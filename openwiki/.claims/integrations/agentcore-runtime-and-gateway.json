    {
      "id": "claim_f1088a0be129447badd2196089ec35cc",
      "statement": "The gateway integration is intentionally per-invocation rather than cached because the OAuth token is short-lived and runtime configuration is read at call time; this keeps stale authorization and stale environment binding out of the request path.",
      "evidence": [

    {
      "id": "claim_56928be59c704b3198e9038ed6b8dab4",
      "statement": "`ApplicationStore` builds every application-data S3 key from `<customer_id>/<application_id>` and never from caller input, keeping all JSON documents and application PDFs inside the verified customer/application prefix.",

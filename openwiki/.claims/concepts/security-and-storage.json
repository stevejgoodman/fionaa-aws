    {
      "id": "claim_51db5ae0c4f64108bf9d496532a34789",
      "statement": "`identity_from_request_context` derives `customer_id` from the verified JWT email claim (`email` or `custom:email`), rejects missing Authorization headers or missing email claims with `ValueError`, and does not trust a caller-supplied customer identifier.",
      "evidence": [
        {
          "resource": "repo://fionaa/app/fionaa/security.py#L74-L98",
          "version": "repo-lines-v1:sha256:2df3fe61d316c2712bec401b8b38b333a69cb5c152ec8ad7c7b1d54f3959fc3f:"
        },
        {

          "version": "repo-lines-v1:sha256:ec3c746b6da7664ea9eda8c1a97247f45043d996572baa3113890fd56935e6c9:"
        }
      ]
    },
    {
      "id": "claim_fbe19d244ec1450298315a0504604d41",
      "statement": "`customer_id` is computed as a SHA-256 hash of the trimmed, lowercased email address, so equivalent email casing or surrounding whitespace maps to the same isolation prefix while keeping the raw email out of storage tags.",

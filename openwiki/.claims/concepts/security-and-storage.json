        },
        {
          "resource": "repo://fionaa/app/fionaa/tests/test_security.py#L40-L47",
          "version": "repo-lines-v1:sha256:8cdf9f285d7fd2ff19626c5b22a2a529d8a77a24149ef8c540ea667152377272:"
        }
      ]
    },
    {
      "id": "claim_b8d06323b6994af3bd35111245c6a0e3",
      "statement": "`CustomerIdentity` rejects unsafe `customer_id` and `application_id` values before they can be used in STS session tags or object keys, failing fast on malformed identity inputs.",

    {
      "id": "claim_847b16a30c5f4a8292ca136677491850",
      "statement": "`FinalDecisionResult` is the success-path terminal schema with `outcome`, `reason`, and `rationale`; `synthesize_decision` combines that structured verdict with the upstream `policy_check`, `companies_house`, `financial_assessment`, and `web_search` values before persisting `decision/result.json`.",
      "evidence": [
        {
          "resource": "repo://fionaa/app/fionaa/graph.py#L482-L529",
          "version": "repo-lines-v1:sha256:3db2d9fac13c04df138c7d7864142cf7a9edb4e9c18c2c37d686cb6805aefff9:"

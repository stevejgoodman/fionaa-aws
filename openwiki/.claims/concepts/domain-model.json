    {
      "id": "claim_1d95bc7e644845a8a0279b7f3ffa4a74",
      "statement": "`PolicyCheckResult` is a structured verdict with `eligible`, `clause_findings`, `documentation_gaps`, and `summary`; the design keeps documentation gaps separate from substantive eligibility so missing evidence alone does not force an ineligible verdict.",
      "evidence": [
        {
          "resource": "repo://fionaa/app/fionaa/graph.py#L194-L251",
          "version": "repo-lines-v1:sha256:86dafad1d76d36b9c0252d48055b54eccbb05e47469fe9e21c8ce73024bcf257:"

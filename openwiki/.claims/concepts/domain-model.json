    {
      "id": "claim_f618313542b84c7ab4c76c7560b9ff78",
      "statement": "`web_search` keeps its state value as the raw search-result string but persists a separate evidence artifact containing the result, redacted tool calls, and a boolean groundedness signal; unlike Companies House, that groundedness signal is audit-only and does not affect routing.",
      "evidence": [
        {
          "resource": "repo://fionaa/app/fionaa/graph.py#L435-L479",
          "version": "repo-lines-v1:sha256:1a7f4c498db264908ea6962f18298356eeb27dbf0c46d901be6aabbd990321a5:"
        },

        <mxCell id="company" value="&lt;b&gt;Verify company identity&lt;/b&gt;&lt;br&gt;&lt;br&gt;Companies House MCP tools&lt;br&gt;Location matching as needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5FF;strokeColor=#607DAB;fontColor=#172B4D;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="760" y="160" width="260" height="110" />
        </mxCell>
        <mxCell id="early" value="&lt;b&gt;Company not confirmed&lt;/b&gt;&lt;br&gt;&lt;br&gt;Early referral recommendation&lt;br&gt;Skip downstream assessments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5FF;strokeColor=#607DAB;fontColor=#172B4D;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="160" width="260" height="110" />
        </mxCell>
        <mxCell id="policy" value="&lt;b&gt;Check lending policy&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bundled general + loan-type policies&lt;br&gt;Deterministic checks + model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5FF;strokeColor=#607DAB;fontColor=#172B4D;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="760" y="380" width="260" height="110" />
        </mxCell>
        <mxCell id="finance" value="&lt;b&gt;Assess financials&lt;/b&gt;&lt;br&gt;&lt;br&gt;Financial documents + model&lt;br&gt;Persist financial assessment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5FF;strokeColor=#607DAB;fontColor=#172B4D;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="400" y="380" width="260" height="110" />
        </mxCell>
        <mxCell id="web" value="&lt;b&gt;Research web presence&lt;/b&gt;&lt;br&gt;&lt;br&gt;Gateway web-search tools + model&lt;br&gt;Persist web evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5FF;strokeColor=#607DAB;fontColor=#172B4D;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="380" width="260" height="110" />
        </mxCell>
        <mxCell id="synth" value="&lt;b&gt;Synthesize recommendation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Combine all four assessments&lt;br&gt;Write decision/proposed.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5FF;strokeColor=#607DAB;fontColor=#172B4D;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="620" width="260" height="110" />
        </mxCell>
        <mxCell id="validate" value="&lt;b&gt;Validate report claims&lt;/b&gt;&lt;br&gt;&lt;br&gt;Automated Reasoning guardrails&lt;br&gt;Attach per-claim validation findings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5FF;strokeColor=#607DAB;fontColor=#172B4D;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="400" y="620" width="260" height="110" />
        </mxCell>
        <mxCell id="report" value="&lt;b&gt;Persist reviewer report&lt;/b&gt;&lt;br&gt;&lt;br&gt;decision/result.json&lt;br&gt;outcome: pending_human_review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5FF;strokeColor=#607DAB;fontColor=#172B4D;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="760" y="620" width="260" height="110" />
        </mxCell>
        <mxCell id="response" value="&lt;b&gt;Return API response&lt;/b&gt;&lt;br&gt;&lt;br&gt;Outcome + S3 artifact URIs&lt;br&gt;Human determines final outcome" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5FF;strokeColor=#607DAB;fontColor=#172B4D;fontSize=14;spacing=12;" vertex="1" parent="1">

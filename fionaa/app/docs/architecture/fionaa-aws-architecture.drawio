          <mxGeometry as="geometry" x="40" y="25" width="1520" height="42" />
        </mxCell>
        <mxCell id="subtitle" value="Application logic inside AgentCore Runtime · Each assessment produces S3 evidence; LangGraph checkpoints use AgentCore Memory." style="text;html=1;align=left;fontSize=13;fontColor=#526477;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="72" width="1520" height="42" />
        </mxCell>
        <mxCell id="identity" value="&lt;b&gt;Resolve caller identity&lt;/b&gt;&lt;br&gt;&lt;br&gt;Verified email → SHA-256 customer_id&lt;br&gt;Assume tagged data-access role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5FF;strokeColor=#607DAB;fontColor=#172B4D;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="160" width="260" height="110" />
        </mxCell>
        <mxCell id="load" value="&lt;b&gt;Load application&lt;/b&gt;&lt;br&gt;&lt;br&gt;Read application + documents&lt;br&gt;from customer/application S3 prefix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5FF;strokeColor=#607DAB;fontColor=#172B4D;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="400" y="160" width="260" height="110" />
